											</div>
										</div>
									</label>
									<select id="u_level" name="u_level" 
											class="w-full px-3 py-2 bg-[#f1ede1] border border-[#e5e5e5] rounded-lg 
												   focus:outline-none focus:ring-2 focus:ring-blue-500 text-[#1a1b1a]">
