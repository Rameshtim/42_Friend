                Active Users: <%= totalActiveUser %>
            </div>

            <!-- Hamburger Icon -->
            <div class="md:hidden">
                <button onclick="toggleMenu()" class="focus:outline-none">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2"
                         viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 6h16M4 12h16M4 18h16"></path>
                    </svg>
                </button>
            </div>

            <!-- Menu Links (Desktop) -->
            <div class="hidden md:flex space-x-6 items-center">
                <a href="/about" class="bg-none px-4 py-2 rounded-lg flex items-center hover:bg-[#f1ede1] transition">About Me</a>
				<a href="/feedback" class="bg-none px-4 py-2 rounded-lg flex items-center hover:bg-[#f1ede1] transition">Feedback</a>
                <a href="/" class="bg-none px-4 py-2 rounded-lg flex items-center hover:bg-[#f1ede1] transition">Home</a>
                <a href="/fetch-users" class="bg-none px-4 py-2 rounded-lg flex items-center hover:bg-[#f1ede1] transition" onclick="showLoading()">Peers</a>

                <a href="/logout" class="bg-none px-4 py-2 rounded-lg flex items-center hover:bg-[#f1ede1] transition">Logout</a>
                <a href="https://github.com/rameshtim/42_friend" target="_blank"
