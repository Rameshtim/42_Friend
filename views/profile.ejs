            <div class="text-center w-full">Active Users: <%= totalActiveUser %></div>
            <a href="/about" class="block w-full hover:text-[#525252]">About Me</a>
			<a href="/feedback" class="bg-none px-4 py-2 rounded-lg flex items-center hover:bg-[#f1ede1] transition">Feedback</a>
            <a href="/" class="block w-full hover:text-[#525252]">Home</a>
            <a href="/fetch-users" class="block w-full hover:text-[#525252]" onclick="showLoading()">Peers</a>

            <a href="/logout" class="block w-full text-[#525252] hover:text-[#525252]">Logout</a>
            <a href="https://github.com/rameshtim/42_friend" target="_blank"
               class="w-full bg-none px-4 py-2 rounded-lg flex items-center hover:bg-[#f1ede1] transition">
                <i class="ph ph-github-logo text-xl mr-2"></i>Contribute
